# ============================================
# CyberHuaTuo 本地配置
# 复制此文件为 .env 并填入你的 API Key
# ============================================

# ===== LLM 提供商（选一个即可） =====

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Ollama（本地模型，无需 API Key）
# OLLAMA_BASE_URL=http://localhost:11434

# ===== 模型配置 =====

# 诊断用 LLM 模型（默认 gpt-4o-mini，可改为 claude-sonnet-4-20250514 / ollama/llama3 等）
DIAGNOSIS_MODEL=gpt-4o-mini

# Embedding 模型（默认使用 ChromaDB 内置的本地模型，无需 API Key）
# 如需使用 OpenAI Embedding，取消下一行注释：
# EMBEDDING_MODEL=openai/text-embedding-3-small

# ===== Context7 官方文档检索 =====

# 启用官方文档检索（默认启用，无需 API Key 也可使用，但有速率限制）
CONTEXT7_ENABLED=true

# Context7 API Key（可选，免费获取：https://context7.com/dashboard）
# 配置后可提升 API 速率限额
# CONTEXT7_API_KEY=your-context7-api-key

# ===== 服务配置 =====

# 本地服务端口
PORT=8000

# 向量数据库存储路径
CHROMA_DB_PATH=.chroma_db
