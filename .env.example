# ============================================
# CyberHuaTuo 本地配置
# 复制此文件为 .env 并填入你的 API Key
# ============================================

# ===== LLM 提供商（选一个即可） =====

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Ollama（本地模型，无需 API Key）
# OLLAMA_BASE_URL=http://localhost:11434

# ===== 国内外其他模型提供商（取消对应注释并填入你的 API Key） =====

# DeepSeek
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# Kimi (Moonshot)
# KIMI_API_KEY=sk-your-kimi-key

# 豆包 (Doubao)
# DOUBAO_API_KEY=your-doubao-key

# MiniMax
# MINIMAX_API_KEY=your-minimax-key

# Groq
# GROQ_API_KEY=gsk_your_groq_key

# Google / Gemini
# GEMINI_API_KEY=AIzaSy-your-gemini-key

# Cohere
# COHERE_API_KEY=your-cohere-key

# ===== 模型配置 =====

# 诊断用 LLM 模型（默认 gpt-4o-mini，可改为 claude-sonnet-4-20250514 / ollama/llama3 等）
DIAGNOSIS_MODEL=gpt-4o-mini

# Embedding 模型（默认使用 ChromaDB 内置的本地模型，无需 API Key）
# 如需使用 OpenAI Embedding，取消下一行注释：
# EMBEDDING_MODEL=openai/text-embedding-3-small

# ===== Context7 官方文档检索 =====

# 启用官方文档检索（默认启用，无需 API Key 也可使用，但有速率限制）
CONTEXT7_ENABLED=true

# Context7 API Key（可选，免费获取：https://context7.com/dashboard）
# 配置后可提升 API 速率限额
# CONTEXT7_API_KEY=your-context7-api-key

# ===== 服务配置 =====

# 本地服务端口
PORT=8000

# 向量数据库存储路径
CHROMA_DB_PATH=.chroma_db

# ===== GitHub Issues 淘金配置 =====

# GitHub Personal Access Token（可选，提升 API 速率限额）
# 无 Token: 60次/小时, 有 Token: 5000次/小时
# 生成方法: GitHub → Settings → Developer settings → Personal access tokens
# GITHUB_TOKEN=ghp_your_github_token

# 每个仓库默认淘金数量
MINE_DEFAULT_LIMIT=10

# 最低 reactions 数过滤（只搜索 reactions >= 此值的 Issues）
MINE_MIN_REACTIONS=3

# 最低 comments 数过滤
MINE_MIN_COMMENTS=2

# ===== GitHub Bot 自动诊断配置 =====

# Bot 最低匹配分数阈值（0-100，低于此分数不自动回复）
# BOT_MIN_SCORE=15

# Bot 最大返回药方数量
# BOT_MAX_RESULTS=3


# ===== 疫情通报配置 =====

# 启用 Agent 生态疫情通报（框架健康度监控）
EPIDEMIC_ENABLED=true

# ===== MCP Server 配置 =====

# CyberHuaTuo MCP Server 使用 stdio 传输协议
# 启动命令：python -m cyberhuatuo.mcp_server
# 或安装后：cyberhuatuo-mcp
#
# 在 AI 工具中配置示例（Claude Desktop / Cursor / VS Code 等）：
# {
#   "mcpServers": {
#     "cyberhuatuo": {
#       "command": "python",
#       "args": ["-m", "cyberhuatuo.mcp_server"],
#       "cwd": "/path/to/CyberHuaTuo"
#     }
#   }
# }

# ===== 瞬时药方搜索配置（双层架构） =====

# 启用瞬时药方搜索（搜索 GitHub Issues 中的用户贡献药方）
# 开启后 diagnose / search_knowledge_base 会同时搜索常驻药方和瞬时药方
EPHEMERAL_SEARCH_ENABLED=true

# ===== GitHub 同步配置 =====

# 贡献者用户名（MCP 工具自动识别你的身份，用于炼丹师称号等）
# GITHUB_USERNAME=your-github-username

# 药方同步到 GitHub 仓库的配置
GITHUB_SYNC_ENABLED=true
GITHUB_SYNC_OWNER=JinNing6
GITHUB_SYNC_REPO=CyberHuaTuo
GITHUB_SYNC_BRANCH=main

# ===== 药方库自动同步 =====

# 从 GitHub 增量拉取新晋升的常驻药方
CASE_SYNC_ENABLED=true
CASE_SYNC_INTERVAL_MINUTES=5

# ===== 滋补药方配置（安全体检） =====

# 启用六经脉安全体检功能
NOURISHING_ENABLED=true

# ===== 服务绑定地址 =====

# 默认绑定到本地回环地址
HOST=127.0.0.1

