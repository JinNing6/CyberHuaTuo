# CyberHuaTuo Boot Animation Recording
# 启动序列动画录制

Output assets/cli_boot_animation.gif

Set Shell "cmd"
Set FontSize 14
Set Width 1200
Set Height 700
Set LetterSpacing 1
Set LineHeight 1.2
Set TypingSpeed 40ms
Set Theme "Catppuccin Mocha"
Set Padding 20
Set Framerate 24
Set PlaybackSpeed 1

# Start recording
Type "python tapes\run_boot.py"
Enter
Sleep 15s
