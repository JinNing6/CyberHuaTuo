# CyberHuaTuo Cinematic Effects Demo Recording
# 电影级特效全览录制

Output assets/cli_cinematic_effects.gif

Set Shell "powershell"
Set FontSize 14
Set Width 1200
Set Height 700
Set LetterSpacing 1
Set LineHeight 1.2
Set TypingSpeed 50ms
Set Theme "Catppuccin Mocha"
Set Padding 20
Set Framerate 30
Set PlaybackSpeed 1.5

# Start recording
Type "python tapes/run_effects.py"
Enter
Sleep 45s
